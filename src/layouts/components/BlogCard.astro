---
import config from "@/config/config.json";
import { FaArrowRight } from "react-icons/fa";
import ImageMod from "./ImageMod.astro";

const { blog_folder } = config.settings;

const { data } = Astro.props;

const {
  title,
  image,
  categories,
  description,
} = data.data;
---

<article
  class="group flex h-full flex-col overflow-hidden rounded-xl border border-border bg-white shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-lg"
>

  <a
    href={`/${blog_folder}/${data.id}`}
    aria-label={title}
  >
    {
      image && (
        <ImageMod
          class="aspect-[16/9] w-full object-cover"
          src={image}
          alt={title}
          width={445}
          height={250}
          format="webp"
        />
      )
    }
  </a>

  <div class="flex flex-1 flex-col p-6">

    <div class="mb-5 flex flex-wrap gap-2">

      {
        categories.map((category: string) => (

          <span
            class="rounded-full bg-sand/20 px-3 py-1 text-sm font-medium text-brand"
          >
        {category}
          </span>

        ))
      }

    </div>

    <h2 class="mb-4 text-2xl font-semibold leading-tight">

      <a
        href={`/${blog_folder}/${data.id}`}
        class="transition-colors group-hover:text-brand"
      >
        {title}
      </a>

    </h2>

    {
      description && (

        <p class="mb-6 flex-1 leading-relaxed text-text">
          {description}
        </p>

      )
    }

    <a
      href={`/${blog_folder}/${data.id}`}
      class="mt-auto inline-flex items-center font-semibold text-brand transition-all duration-300 group-hover:translate-x-1"
    >
      Czytaj artykuł

      <FaArrowRight className="ml-2" />

    </a>

  </div>

</article>