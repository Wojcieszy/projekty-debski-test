---
interface Props {
  rating: string;
  reviewCount: number;
  googleUrl: string;
}

const { rating, reviewCount, googleUrl } = Astro.props;
---

<div
  class="rounded-2xl border border-border bg-white p-8 shadow-sm"
>

  <div class="flex items-center gap-4">

    <img
      src="/images/Google__G__logo.svg"
      alt="Google"
      class="h-12 w-12"
    />

    <div>

      <p class="text-2xl font-bold text-dark">
        Google
      </p>

      <p class="text-text">
        Zweryfikowana wizytówka
      </p>

    </div>

  </div>

  <div class="mt-8">

    <div class="text-4xl">
      ⭐⭐⭐⭐⭐
    </div>

    <p class="mt-3 text-5xl font-bold text-dark">
      {rating}
    </p>

    <p class="mt-2 text-lg text-text">
      na podstawie <strong>{reviewCount}</strong> opinii
    </p>

  </div>

  <a
    href={googleUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="mt-8 inline-flex min-h-13 items-center justify-center rounded-sm bg-sand px-7 py-3 font-semibold text-brand transition hover:bg-sand-light"
  >
    Zobacz wszystkie opinie →
  </a>

</div>