---
interface Props {
  author: string;
  initials: string;
  date: string;
  text: string;
}

const { author, initials, date, text } = Astro.props;
---

<article
  class="flex h-full flex-col rounded-2xl border border-border bg-white p-8 shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-lg"
>

  <div class="mb-6 flex items-center justify-between">

    <img
      src="/images/Google__G__logo.svg"
      alt="Google"
      class="h-7 w-7"
    />

    <div class="text-lg">
      ⭐⭐⭐⭐⭐
    </div>

  </div>

  <p class="flex-1 leading-relaxed text-text">
    "{text}"
  </p>

  <div class="mt-8 flex items-center gap-4">

    <div
      class="flex h-12 w-12 items-center justify-center rounded-full bg-brand font-semibold text-white"
    >
      {initials}
    </div>

    <div>

      <p class="font-semibold text-dark">
        {author}
      </p>

      <p class="text-sm text-text-light">
        {date}
      </p>

    </div>

  </div>

</article>