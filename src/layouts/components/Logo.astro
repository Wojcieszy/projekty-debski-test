---
import config from "@/config/config.json";

const { logo, logo_width, logo_height } = config.site;
---

<a href="/" class="navbar-brand" aria-label="Projekty Dębski — strona główna">
  <span class="brand-mark" aria-hidden="true">
    <img
      src={logo}
      alt=""
      width={logo_width}
      height={logo_height}
class="h-[94%] w-[94%] object-contain brightness-0 invert"
    />
  </span>

  <span class="brand-name">
    <span>Projekty</span>
    <span>Dębski</span>
  </span>
</a>
