---
import config from "@/config/config.json";

const { logo, logo_width, logo_height } = config.site;
---

<a href="/" class="navbar-brand flex items-center gap-3">
  <!-- Logo -->
  <img
    src={logo}
    alt="Projekty Dębski"
    width={logo_width}
    height={logo_height}
    class="object-contain"
  />

  <!-- Nazwa firmy -->
  <div class="leading-none">
    <span class="block text-xl font-bold text-white">
      Projekty
    </span>

    <span class="block text-xl font-bold text-white">
      Dębski
    </span>
  </div>
</a>