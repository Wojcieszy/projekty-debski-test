---
import ServiceCard from "@/components/ServiceCard.astro";
---

<section
  id="nasze-uslugi"
  class="bg-mist scroll-mt-24 pt-10 pb-18 lg:pt-10 lg:pb-18"
>
  <div class="container">
    <div class="mx-auto max-w-[1200px]">
      <div class="mx-auto mb-14 max-w-xl text-center lg:mb-16">
        <h2 class="text-3xl leading-tight text-text-dark lg:text-4xl">
          Moje usługi
        </h2>
        <p class="mt-5 text-lg text-text">
          Wybierz usługę, która Cię interesuje.
        </p>
      </div>

      <div class="grid items-stretch gap-7 md:grid-cols-2 lg:gap-8">
        <ServiceCard
          title="Świadectwa charakterystyki energetycznej"
          description="Sporządzanie świadectw dla mieszkań, domów i lokali użytkowych."
          href="/swiadectwa"
          image="/images/services/swiadectwo-kot2.webp"
          imageWidth={1200}
          imageHeight={1600}
        />

        <ServiceCard
          title="Projekty budowlane"
          description="Projekty instalacji wodociągowych, kanalizacyjnych i grzewczych."
          href="/projekty"
          image="/images/services/Projekty-Kot.webp"
          imageWidth={1280}
          imageHeight={960}
        />
      </div>
    </div>
  </div>
</section>
