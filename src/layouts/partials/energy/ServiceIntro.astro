---
interface Props {
  title: string;
  paragraphs: string[];
}

const { title, paragraphs } = Astro.props;
---

<section class="section">
  <div class="container">
    <div class="mx-auto max-w-4xl">

      <h2>{title}</h2>

      {
        paragraphs.map((paragraph) => (
          <p class="mt-6">
            {paragraph}
          </p>
        ))
      }

    </div>
  </div>
</section>