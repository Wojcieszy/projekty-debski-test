---
import ImageMod from "@/components/ImageMod.astro";

export interface Props {
  title: string;
  subtitle?: string;

  // Opcjonalne zdjęcie tła
  image?: string;

  // Opcjonalny przycisk CTA
  buttonText?: string;
  buttonHref?: string;
}

const {
  title,
  subtitle,
  image = "/images/banner-blok.webp",
  buttonText,
  buttonHref,
} = Astro.props;
---

<section class="relative h-[340px] overflow-hidden md:h-[420px]">

  <!-- Zdjęcie -->
  <ImageMod
    src={image}
    alt={title}
    class="absolute inset-0 h-full w-full object-cover"
    style="object-position: 65% 40%;"
    width={1920}
    height={700}
    fit="cover"
  />

  <!-- Delikatne przyciemnienie -->
  <div class="absolute inset-0 bg-black/30"></div>

  <!-- Gradient poprawiający czytelność -->
  <div
    class="absolute inset-0 bg-gradient-to-r from-brand/75 via-brand/45 via-brand/20 to-transparent"
    aria-hidden="true"
  ></div>

  <!-- Treść -->
  <div class="absolute inset-0 flex items-center">

    <div class="container">

      <div class="max-w-4xl">

        <h1 class="text-4xl leading-tight text-white sm:text-4xl lg:text-4xl">
          {title}
        </h1>

        {
          subtitle && (
      <div class="mt-6 max-w-2xl text-lg leading-relaxed text-white/90 md:text-xl">

              <p>
                {subtitle}
              </p>

            </div>
          )
        }

        {
          buttonText && buttonHref && (
            <div class="mt-8">
              <a
                href={buttonHref}
                class="inline-flex min-h-13 items-center justify-center rounded-sm bg-sand px-7 py-3 font-semibold text-brand transition hover:bg-sand-light focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
              >
                {buttonText}
              </a>
            </div>
          )
        }

      </div>

    </div>

  </div>

</section>