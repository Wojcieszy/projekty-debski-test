---
import { projectService } from "@/data/services/projects";
---

<section class="section bg-mist">
  <div class="container">

    <div class="mb-12 text-center">
      <h2>{projectService.services.title}</h2>
    </div>

    <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">

      {
        projectService.services.items.map((item) => (
          <article class="overflow-hidden rounded-xl border border-border bg-white shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-lg">

            {
              item.image && (
                <img
                  src={item.image}
                  alt={item.title}
                  class="h-56 w-full object-cover"
                  loading="lazy"
                />
              )
            }

            <div class="p-8">

              <h3 class="mb-4 text-2xl font-semibold text-dark">
                {item.title}
              </h3>

              <p class="text-text">
                {item.description}
              </p>

            </div>

          </article>
        ))
      }

    </div>

  </div>
</section>