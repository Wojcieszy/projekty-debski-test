---
/* Layout strony */
import Base from "@/layouts/Base.astro";

/* Baner */
import PageBanner from "@/layouts/partials/PageBanner.astro";
---

<Base
  title="O firmie Projekty Dębski"
  description="Poznaj firmę Projekty Dębski. Oferuję świadectwa charakterystyki energetycznej oraz projekty budowlane z dbałością o jakość i terminowość."
>
  <PageBanner
    title="O firmie"
    subtitle="Poznaj firmę Projekty Dębski i zakres świadczonych usług."
  />

  <section class="section">
    <div class="container">

      <div class="mx-auto max-w-4xl">

        <h2 class="mb-6">
          Projekty Dębski
        </h2>

        <p class="mb-6">
          Projekty Dębski to firma specjalizująca się w wykonywaniu świadectw
          charakterystyki energetycznej oraz opracowywaniu dokumentacji
          projektowej.
        </p>

        <p class="mb-6">
          Każde zlecenie realizowane jest z dbałością o zgodność z
          obowiązującymi przepisami, terminowość oraz indywidualne potrzeby
          klienta.
        </p>

        <p>
          Celem jest dostarczanie rzetelnych opracowań, które spełniają
          wymagania formalne i pomagają klientom sprawnie przejść przez proces
          sprzedaży, wynajmu lub realizacji inwestycji.
        </p>

      </div>

    </div>
  </section>

</Base>