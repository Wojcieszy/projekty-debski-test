---
/* Layout strony */
import Base from "@/layouts/Base.astro";

/* Baner */
import PageBanner from "@/layouts/partials/PageBanner.astro";
---

<Base
  title="Świadectwo charakterystyki energetycznej dla domu jednorodzinnego"
  description="Wykonuję świadectwa charakterystyki energetycznej dla domów jednorodzinnych zgodnie z obowiązującymi przepisami."
>
  <PageBanner
    title="Świadectwo dla domu jednorodzinnego"
    subtitle="Informacje o świadectwach charakterystyki energetycznej dla domów jednorodzinnych."
  />

  <section class="section">
    <div class="container">

      <div class="mx-auto max-w-4xl">

        <h2 class="mb-6">
          Świadectwo charakterystyki energetycznej dla domu jednorodzinnego
        </h2>

        <p class="mb-6">
          Świadectwo charakterystyki energetycznej określa zapotrzebowanie domu
          na energię niezbędną do jego użytkowania. Dokument jest sporządzany
          zgodnie z obowiązującymi przepisami i może być wymagany przy sprzedaży
          lub wynajmie nieruchomości.
        </p>

        <p class="mb-6">
          Każdy dom jest inny, dlatego podczas opracowania świadectwa
          uwzględniane są jego parametry techniczne, zastosowane materiały oraz
          systemy ogrzewania i wentylacji.
        </p>

        <p>
          Poniżej znajdziesz informacje dotyczące wymaganych danych, przebiegu
          realizacji oraz odpowiedzi na najczęściej zadawane pytania.
        </p>

      </div>

    </div>
  </section>

</Base>