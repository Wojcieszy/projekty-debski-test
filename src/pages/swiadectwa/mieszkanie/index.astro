---
/* Layout strony */
import Base from "@/layouts/Base.astro";



/* Baner */
import PageBanner from "@/layouts/partials/PageBanner.astro";

/* Sekcje dedykowane mieszkaniom */

import { apartmentService } from "@/data/services/apartment";
import CardsSection from "@/layouts/partials/energy/CardsSection.astro";


/* Wspólne sekcje */
import HowItWorks from "@/layouts/partials/energy/HowItWorks.astro";
import WhyChooseUs from "@/layouts/partials/energy/WhyChooseUs.astro";
import EnergyCta from "@/layouts/partials/energy/EnergyCta.astro";
import PriceCards from "@/layouts/components/PriceCards.astro";


import RelatedServices from "@/layouts/components/RelatedServices.astro";
---

<Base
  title="Świadectwo charakterystyki energetycznej dla mieszkania"
  description="Wykonuję świadectwa charakterystyki energetycznej dla mieszkań zgodnie z obowiązującymi przepisami."

>


 <PageBanner
  title="Świadectwo energetyczne dla mieszkania"
  subtitle="Potrzebujesz świadectwa charakterystyki energetycznej dla mieszkania? Wykonuję świadectwa zgodnie z obowiązującymi przepisami. Zapewniam szybką realizację oraz dokument gotowy do sprzedaży lub wynajmu."
  image="/images/services/sche-blok.webp"
  buttonText="Skontaktuj się"
  buttonHref="/kontakt"
/>
  <CardsSection
  title={apartmentService.whenRequired.title}
  description={apartmentService.whenRequired.description}
  cards={apartmentService.whenRequired.cards}
/>

  <CardsSection
  title={apartmentService.documents.title}
  description={apartmentService.documents.description}
  cards={apartmentService.documents.cards}
/>
  <HowItWorks />

<PriceCards {...apartmentService.pricing} />


<WhyChooseUs
  title="Dlaczego właściciele mieszkań wybierają Projekty Dębski?"
  subtitle="Stawiam na rzetelność, terminowość oraz indywidualne podejście do każdego zlecenia. Dzięki temu otrzymujesz nie tylko wymagany dokument, ale również wsparcie na każdym etapie współpracy."
/>



<RelatedServices
  services={[
    {
      title: "Świadectwa charakterystyki energetycznej",
      description:
        "Dowiedz się, kiedy świadectwo jest wymagane, jakie są przepisy oraz dla jakich budynków wykonuję świadectwa charakterystyki energetycznej.",
      href: "/swiadectwa",
      image: "/images/services/sche-kwiaty.jpg",
      imageWidth: 960,
      imageHeight: 640,
      imageAlt:
        "Świadectwa charakterystyki energetycznej dla mieszkań, domów i lokali użytkowych",
    },
    {
      title: "Świadectwo dla domu jednorodzinnego",
      description:
        "Sprawdź wymagania dotyczące świadectwa charakterystyki energetycznej dla domu jednorodzinnego oraz przebieg realizacji usługi.",
      href: "/swiadectwa/dom-jednorodzinny",
      image: "/images/services/sche-dom.webp",
      imageWidth: 960,
      imageHeight: 640,
      imageAlt:
        "Świadectwo charakterystyki energetycznej dla domu jednorodzinnego",
    },
   {
      title: "Artykuły o mieszkaniach",
      description:
        "Przeczytaj więcej o świadectwach charakterystyki energetycznej dla mieszkań.",
      href: "/artykuly",
      image: "/images/services/sche-blok.webp",
      imageWidth: 960,
      imageHeight: 640,
      imageAlt:
        "Świadectwo charakterystyki energetycznej dla mieszkania",
    },
  ]}
/>

  <EnergyCta />

</Base>