---
/* Layout strony */
import Base from "@/layouts/Base.astro";

/* Baner */
import PageBanner from "@/layouts/partials/PageBanner.astro";
---

<Base
  title="Polityka prywatności | Projekty Dębski"
  description="Informacje dotyczące przetwarzania danych osobowych oraz polityki prywatności serwisu Projekty Dębski."
>
  <PageBanner
    title="Polityka prywatności"
    subtitle="Informacje o zasadach przetwarzania danych osobowych."
  />

  <section class="section">
    <div class="container">

      <div class="mx-auto max-w-4xl">

        <h2 class="mb-6">
          Polityka prywatności
        </h2>

        <p class="mb-6">
          Niniejsza strona zawiera informacje dotyczące zasad przetwarzania
          danych osobowych oraz korzystania z serwisu internetowego Projekty
          Dębski.
        </p>

        <p class="mb-6">
          Treść polityki prywatności zostanie uzupełniona przed publikacją
          strony internetowej.
        </p>

      </div>

    </div>
  </section>

</Base>