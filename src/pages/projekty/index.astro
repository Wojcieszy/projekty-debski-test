---
/* Layout strony */
import Base from "@/layouts/Base.astro";

/* Baner */
import PageBanner from "@/layouts/partials/PageBanner.astro";
---

<Base
  title="Projekty budowlane"
  description="Oferuję wykonanie projektów budowlanych oraz pomoc w przygotowaniu dokumentacji projektowej."
>
  <PageBanner
    title="Projekty budowlane"
    subtitle="Kompleksowe opracowanie dokumentacji projektowej."
  />

  <section class="section">
    <div class="container">

      <div class="mx-auto max-w-4xl">

        <h2 class="mb-6">
          Projekty budowlane
        </h2>

        <p class="mb-6">
          Oferuję wykonanie projektów budowlanych dostosowanych do obowiązujących
          przepisów oraz indywidualnych potrzeb inwestora.
        </p>

        <p class="mb-6">
          Zakres opracowania zależy od rodzaju inwestycji i obejmuje przygotowanie
          dokumentacji niezbędnej do realizacji przedsięwzięcia.
        </p>

        <p>
          Na stronie znajdziesz informacje o przebiegu współpracy, wymaganych
          dokumentach oraz odpowiedzi na najczęściej zadawane pytania.
        </p>

      </div>

    </div>
  </section>

</Base>